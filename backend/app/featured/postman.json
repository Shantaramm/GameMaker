 "endings": [
  {
   "id": "ending_open",
   "title": "Дорога открыта",
   "text": "Долговая книга легла на стол городского пристава. Банда Якова разбежалась по ущельям, старосту Гордея увезли в город под конвоем. Лекарь поднялся в Кедровку за день до первого снега, а Мирон до весны носил письма с гордо поднятой головой.",
   "kind": "good"
  },
  {
   "id": "ending_letter",
   "title": "Письмо дошло",
   "text": "Прошение легло на стол в городской управе, и лекарь пообещал прийти. Но доказательств не было: Гордей встретил Мирона на площади с ласковой улыбкой, и снег закрыл перевал вместе со всеми его тайнами. Зима в Кедровке будет долгой.",
   "kind": "neutral"
  }
 ],
