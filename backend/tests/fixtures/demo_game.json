               "choices": [
                {"text": "Я рада тебя видеть. Рассказывай всё, я слушаю.", "effects": [{"set_flag": "trusted_tim", "value": true}], "next": "n3"},
                {"text": "Без лирики. Что с маяком?", "effects": [], "next": "n3"},
