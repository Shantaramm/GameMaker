# Скопируй в .env и заполни. .env в git не попадает.
GIGACHAT_AUTH_KEY=            # ключ авторизации (Base64) из личного кабинета; пусто — демо-режим
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_BASE_URL=https://api.giga.chat
GIGACHAT_MODEL_TEXT=GigaChat-2-Max
GIGACHAT_MODEL_FAST=GigaChat-2
GIGACHAT_CA_BUNDLE=./certs/russian_trusted_root_ca.cer
LLM_PROVIDER=                 # gigachat | demo; пусто — gigachat, если есть ключ, иначе demo
MAX_CONCURRENT_GENERATIONS=3
GAMES_PER_HOUR_PER_IP=5
DATA_DIR=./data
