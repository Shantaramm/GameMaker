,"name":"Точный удар","description":"Удар в уязвимое место, который не смягчает броня.","cost_focus":3,"effect":[{"damage":14}],"target":"enemy"},{"id":"salt_ward","name":"Соляной круг","description":"Круг из соли отгоняет тьму: немного лечит и укрепляет защиту до конца боя.","cost_focus":2,"effect":[{"heal":8},{"mod_stat":"defense","delta":3}],"target":"self"}],"items":[{"id":"tonic","name":"Бабушкина настойка","description":"Горькая, но ставит на ноги.","icon":"potion","kind":"consumable","effect":[{"heal":20}],"value_tier":1,"price":10},{"id":"salt_pouch","name":"Мешочек морской соли","description":"Брошенная горсть соли жжёт порождения тумана.","icon":"pouch","kind":"consumable","effect":[{"damage":12}],"value_tier":1,"price":10},{"id":"archive_key","name":"Ключ от архива","description":"Медный ключ с биркой портовой управы.","icon":"key","kind":"key","effect":[],"value_tier":1,"price":10},{"id":"ledger","name":"Журнал Олеандра","description":"Записи о «подношениях морю» с датами исчезновений.","icon":"book","kind":"misc","effect":[],"value_tier":2,"price":22},{"id":"city_coat","name":"Столичное пальто","description":"Добротное, но для портовой сырости тонковато.","icon":"coat","kind":"equipment","effect":[],"equip":{"slot":"body","bonus":{"attack":0,"defense":1,"focus":0,"hp":0,"skills":{}},"range":1},"value_tier":1,"price":10},{"id":"oilskin_coat","name":"Рыбацкий плащ","description":"Промасленная кожа: не промокает и держит удар.","icon":"coat","kind":"equipment","effect":[],"equip":{"slot":"body","bonus":{"attack":0,"defense":3,"focus":0,"hp":5,"skills":{}},"range":1},"value_tier":2,"price":22},{"id":"fishing_knife","name":"Разделочный нож","description":"Острый, как язык Марфы.","icon":"knife","kind":"equipment","effect":[],"equip":{"slot":"hand","bonus":{"attack":2,"defense":0,"focus":0,"hp":0,"skills":{}},"range":1},"value_tier":1,"price":10},{"id":"harpoon","name":"Старый гарпун","description":"Тяжёлый, зато достаёт врага за две клетки.","icon":"spear","kind":"equipment","effect":[],"equip":{"slot":"hand","bonus":{"attack":2,"defense":0,"focus":0,"hp":0,"skills":{}},"range":2},"value_tier":2,"price":22},{"id":"harbor_badge","name":"Жетон портовой стражи","description":"Старый жетон. Когда держишь его, страх отступает.","icon":"badge","kind":"equipment","effect":[],"equip":{"slot":"trinket","bonus":{"attack":0,"defense":1,"focus":1,"hp":0,"skills":{}},"range":1},"value_tier":2,"price":22},{"id":"signed_scrap","name":"Обрывок с подписью «О.»","description":"«…к новолунию — ещё троих. Море не ждёт. — О.»","icon":"letter","kind":"clue","effect":[],"value_tier":1,"price":10},{"id":"salt_order","name":"Запись о соли","description":"Смотритель записал: магистр снова заказал ящик соли.","icon":"notebook","kind":"clue","effect":[],"value_tier":1,"price":10},{"id":"sea_salt","name":"Морская соль","description":"Крупные кристаллы с просоленных бочек. Туман её не любит.","icon":"crystal","kind":"material","effect":[],"value_tier":1,"price":10},{"id":"sea_wormwood","name":"Морская полынь","description":"Горькая трава со скал у маяка. Отвар бодрит и лечит.","icon":"herb","kind":"material","effect":[],"value_tier":1,"price":10}],"enemies":[{"id":"dock_rat","name":"Портовая крыса","description":"Крыса размером с собаку, глаза светятся тем же холодным светом, что и туман.","tier":1,"appearance":{"body":"rat","color":"ash","accent_color":"pale_cyan","features":["fangs"],"size":"small"},"abilities":[{"name":"Укус","effect":[{"damage":8}],"every_n_turns":3}],"range":1,"hp":17,"attack":6,"defense":1,"xp":12,"gold":6},{"id":"cultist","name":"Служитель тумана","description":"Бывший рыбак в мокром балахоне, говорит голосом Олеандра.","tier":2,"appearance":{"head":"square","skin":"olive","hair":"hood","hair_color":"black","eyes":"small","eye_color":"pale_cyan","brows":"straight","mouth":"stern","outfit":"rags","outfit_color":"ash","accent_color":"pale_cyan","accessory":[],"bg_color":"navy"},"abilities":[],"range":3,"hp":28,"attack":8,"defense":2,"xp":20,"gold":10},{"id":"shade","name":"Морская тень","description":"Сгусток тумана с очертаниями человека.","tier":3,"appearance":{"body":"ghost","color":"navy","accent_color":"pale_cyan","features":["third_eye"],"size":"large"},"abilities":[{"name":"Холод глубин","effect":[{"damage":10}],"every_n_turns":3}],"range":1,"hp":40,"attack":10,"defense":4,"xp":32,"gold":16}],"shops":[{"id":"marfa_stall","name":"Прилавок Марфы","items":["tonic","salt_pouch","fishing_knife","oilskin_coat","harpoon"],"buys":true}],"tactics":[{"id":"base_focus","name":"Сосредоточиться","description":"Атака бойца +3 до конца следующего хода врагов.","icon":"dagger","currency":"points","tier":1,"target":"unit","effect":[{"mod_stat":"attack","delta":3}],"duration":1,"move_bonus":0,"cost":2},{"id":"base_dash","name":"Рывок","description":"Боец пройдёт на 2 клетки дальше в этот ход.","icon":"boots","currency":"points","tier":1,"target":"unit","effect":[],"duration":1,"move_bonus":2,"cost":2},{"id":"base_guard","name":"Сомкнуть ряды","description":"Защита всего отряда +2 до следующего хода.","icon":"shield","currency":"points","tier":2,"target":"party","effect":[{"mod_stat":"defense","delta":2}],"duration":1,"move_bonus":0,"cost":4},{"id":"base_second_wind","name":"Второе дыхание","description":"Боец восстанавливает 12 здоровья.","icon":"herb","currency":"points","tier":2,"target":"unit","effect":[{"heal":12}],"duration":1,"move_bonus":0,"cost":4},{"id":"tim_whistle","name":"Свисток Тимофея","description":"Тим свистит по-рыбацки — враги теряют строй: защита −2 на два хода.","icon":"feather","currency":"points","tier":2,"target":"enemies","effect":[{"mod_stat":"defense","delta":-2}],"duration":2,"move_bonus":0,"unlock":{"flag":"tim_joined","is":true},"cost":4},{"id":"marfa_salt","name":"Горсть Марфиной соли","description":"Соль в глаза тварям тумана: атака врагов −2 на два хода.","icon":"pouch","currency":"gold","tier":1,"target":"enemies","effect":[{"mod_stat":"attack","delta":-2}],"duration":2,"move_bonus":0,"unlock":{"flag":"talked_marfa","is":true},"cost":8},{"id":"oleander_notes","name":"Записи Олеандра","description":"Вы знаете, куда бить: атака отряда +3 на ход.","icon":"book","currency":"points","tier":3,"target":"party","effect":[{"mod_stat":"attack","delta":3}],"duration":1,"move_bonus":0,"unlock":{"has_item":"ledger"},"cost":6}],"deductions":[{"id":"salt_for_the_sea","name":"Олеандр кормит море людьми","text":"«О.» просит «ещё троих к новолунию», а ящики соли идут в маяк. Соль не для рыбы — для круга. Магистр приносит морю жертвы.","clues":["signed_scrap","salt_order"],"effects":[{"set_flag":"oleander_exposed","value":true},{"mod_skill":"logic","delta":1}]}],"recipes":[{"id":"make_salt_pouch","result":"salt_pouch","amount":1,"inputs":[{"item":"sea_salt","count":2}],"station":"anywhere"},{"id":"brew_tonic","result":"tonic","amount":1,"inputs":[{"item":"sea_wormwood","count":2}],"station":"campfire"}],"quests":[{"id":"light_the_lamp","title":"Зажечь маяк","main":true,"giver":"tim","stages":[{"text":"Попасть в архив портовой управы","done":{"has_item":"archive_key"}},{"text":"Разузнать, чем занят магистр Олеандр","done":{"any":[{"flag":"found_ledger","is":true},{"flag":"heard_rumor","is":true}]}},{"text":"Пробиться к двери маяка","done":{"defeated":"guardians"}}]},{"id":"marfa_nets","title":"Крысы в сетях","main":false,"giver":"marfa","start":{"flag":"talked_marfa","is":true},"stages":[{"text":"Прогнать крыс из рыбного переулка","done":{"defeated":"rats"}},{"text":"Вернуться к Марфе за наградой","done":{"flag":"marfa_rewarded","is":true}}]}],"flags":[{"id":"trusted_tim","description":"Арина открылась Тимофею и доверяет ему"},{"id":"tim_joined","description":"Тимофей идёт вместе с Ариной"},{"id":"found_ledger","description":"Арина нашла журнал Олеандра в архиве"},{"id":"heard_rumor","description":"Арина узнала слухи о подношениях морю"},{"id":"talked_marfa","description":"Марфа рассказала про крыс"},{"id":"marfa_rewarded","description":"Марфа отблагодарила за крыс"},{"id":"oleander_exposed","description":"Арина поняла, зачем Олеандру соль и люди"}],"locations":[{"id":"pier","title":"Пристань","intro":"Паром причаливает в полночь. Над бухтой должен гореть маяк, но мыс тонет в темноте, и туман ползёт по доскам пристани, как живой.","theme":"town_street","background":{"setting":"outdoor","time":"night","sky":"moon","far":"sea_cliffs","props":[],"ground":"planks","overlay":"fog","mood_palette":"cold_sea"},"size":"medium","floors":1,"zones":[{"id":"ferry","floor":0,"name":"у парома"},{"id":"lamp","floor":0,"name":"под фонарём"},{"id":"stall","floor":0,"name":"прилавок Марфы"}],"objects":[{"id":"salt_crust","zone":"ferry","type":"gather","look":"barrel","name":"Соляная корка на бочках","item":"sea_salt","amount":2,"skill":"perception"},{"id":"loose_plank","zone":"lamp","hidden":{"skill":"perception","difficulty":"medium","text":"Доска у фонаря прибита свежими гвоздями — под ней пустота."},"type":"chest","look":"barrel","contents":[{"give_gold":12},{"give_item":"tonic"}]},{"id":"tim_on_pier","zone":"lamp","condition":{"flag":"tim_joined","is":false},"type":"npc","character":"tim","dialogue":{"type":"dialogue","id":"meet_tim","nodes":[{"id":"n1","speaker":"tim","text":"Арина! Ты всё-таки приехала. Я думал, письмо утонуло вместе с почтовым ботом.","emotion":"happy","passive":[],"choices":[],"next":"n2"},{"id":"n2","speaker":"arina","text":"Я здесь. Что происходит, Тим?","emotion":"neutral","passive":[{"skill":"empathy","difficulty":"easy","text":"Он улыбается слишком широко. Так улыбаются, когда три ночи не спали от страха."}],"choices":[{"text":"Я рада тебя видеть. Рассказывай всё, я слушаю.","effects":[{"set_flag":"trusted_tim","value":true}],"next":"n3"},{"text":"Без лирики. Что с маяком?","effects":[],"next":"n3"},{"text":"Письмо пришло неделю назад. Ты написал его до того, как погас маяк?","effects":[],"next":"n2b","check":{"skill":"logic","difficulty":"medium","red":false,"failure":"n3"}}]},{"id":"n2b","speaker":"tim","text":"…Ты всегда это замечала. Да. Маяк мигал три ночи подряд — неровно, будто кто-то подавал знак. А потом погас совсем.","emotion":"surprised","passive":[],"choices":[],"next":"n3"},{"id":"n3","speaker":"tim","text":"Маяк погас три ночи назад. Смотритель пропал. А в маяке теперь живёт этот… магистр. Говорят, в архиве управы есть всё про него.","emotion":"scared","passive":[],"choices":[],"next":"n4"},{"id":"n4","speaker":"tim","text":"Возьми настойку — бабушка передала. И… можно мне с тобой?","emotion":"neutral","passive":[],"choices":[{"text":"Идём вместе.","effects":[{"give_item":"tonic"},{"set_flag":"tim_joined","value":true}],"next":"end"},{"text":"Жди здесь, так безопаснее.","effects":[{"give_item":"tonic"}],"next":"end"}]}],"start_node":"n1","entries":[]},"barks":[{"text":"Фонарь мигнул… или показалось?"},{"text":"Арина, только не уходи одна, ладно?","condition":{"flag":"tim_joined","is":false}}]},{"id":"marfa_at_stall","zone":"stall","type":"npc","character":"marfa","dialogue":{"type":"dialogue","id":"talk_marfa","nodes":[{"id":"n1","speaker":"marfa","text":"Стрельцова! Выросла-то как. Рыбу не предлагаю — ты по делу, вижу. Нож, плащ, настойку?","emotion":"happy","passive":[],"choices":[{"text":"Что слышно в порту?","effects":[{"set_flag":"heard_rumor","value":true}],"next":"n2"},{"text":"Вы чем-то встревожены.","effects":[{"set_flag":"talked_marfa","value":true}],"next":"n3"},{"text":"Вы боитесь не крыс, Марфа.","effects":[],"next":"n5","check":{"skill":"empathy","difficulty":"medium","red":false,"failure":"n3"}},{"text":"Крысы в переулке больше не побеспокоят.","condition":{"all":[{"defeated":"rats"},{"flag":"marfa_rewarded","is":false}]},"effects":[{"give_gold":20},{"set_flag":"marfa_rewarded","value":true}],"next":"n4"},{"text":"Покажите товар.","effects":[],"next":"end"}]},{"id":"n2","speaker":"marfa","text":"Говорят, магистр носит морю «подношения». Кто к маяку ночью сунулся — того больше не видели.","emotion":"scared","passive":[],"choices":[],"next":"end"},{"id":"n3","speaker":"marfa","text":"Крысы! В рыбном переулке завелись — с собаку ростом, сети рвут. Прогонишь — не обижу.","emotion":"angry","passive":[],"choices":[],"next":"end"},{"id":"n4","speaker":"marfa","text":"Вот это я понимаю — столичная выучка! Держи, заслужила.","emotion":"happy","passive":[],"choices":[],"next":"end"},{"id":"n5","speaker":"marfa","text":"…Сын мой ходил к маяку. Три ночи назад. Сказал — свет погас, надо глянуть. Не вернулся. А я стою, торгую. Что мне ещё делать?","emotion":"sad","passive":[],"choices":[],"next":"end"}],"start_node":"n1","entries":[]},"shop":"marfa_stall","barks":[{"text":"Рыба свежая, ножи острые, слухи — бесплатно!"},{"text":"Ночью туман опять пел. Ей-богу, пел.","condition":{"flag":"talked_marfa","is":false}},{"text":"Крысы ушли! Спасибо, Стрельцова!","condition":{"defeated":"rats"}}]},{"id":"pier_to_alley","zone":"stall","type":"exit","kind":"right_edge","to":"alley"}],"on_enter":[{"type":"narration","id":"arrival","text":"У фонаря кто-то машет рукой — слишком знакомо, чтобы ошибиться."}]},{"id":"alley","title":"Рыбный переулок","intro":"Короткий путь к управе лежит через рыбный переулок. Под ногами хрустит чешуя, а из темноты доносится писк — слишком низкий для обычных крыс.","theme":"town_street","background":{"setting":"outdoor","time":"night","sky":"stars","far":"city","props":[],"ground":"cobblestone","overlay":"rain","mood_palette":"cold_sea"},"size":"medium","floors":1,"zones":[{"id":"entrance","floor":0,"name":"начало переулка"},{"id":"nets","floor":0,"name":"сети и бочки"},{"id":"dead_end","floor":0,"name":"тупик у управы"}],"objects":[{"id":"alley_to_pier","zone":"entrance","type":"exit","kind":"left_edge","to":"pier"},{"id":"torn_letter","zone":"entrance","type":"thing","look":"barrel","name":"Обрывок письма","event":{"type":"choice","id":"read_letter","prompt":"На бочке прибит мокрый обрывок: «…к новолунию — ещё троих. Море не ждёт. — О.»","options":[{"text":"Запомнить подпись","effects":[{"set_flag":"heard_rumor","value":true},{"give_item":"signed_scrap"}]}]},"once":true},{"id":"rats","zone":"nets","type":"enemy","enemies":["dock_rat","dock_rat"],"on_win":[],"on_lose":"game_over","can_flee":true},{"id":"net_crates","zone":"dead_end","type":"chest","look":"crates","contents":[{"give_item":"archive_key"},{"give_gold":8}]},{"id":"alley_to_archive","zone":"dead_end","type":"exit","kind":"door","to":"archive","requires":{"has_item":"archive_key"},"locked_text":"Дверь архива заперта. Нужен ключ."},{"id":"alley_to_cliffs","zone":"dead_end","type":"exit","kind":"right_edge","to":"lighthouse_foot"}],"on_enter":[]},{"id":"archive","title":"Архив управы","intro":"Управа спит, но в архиве дрожит огонёк свечи. Кто-то не спит среди старых бумаг.","theme":"house_interior","background":{"setting":"indoor","time":"night","far":"room_wall","props":[],"ground":"planks","overlay":"dust","mood_palette":"warm_candle"},"size":"small","floors":2,"zones":[{"id":"door","floor":0,"name":"у двери"},{"id":"desk","floor":0,"name":"стол архивариуса"},{"id":"shelves","floor":1,"name":"стеллажи"},{"id":"window","floor":1,"name":"окно"}],"objects":[{"id":"false_book","zone":"window","hidden":{"skill":"perception","difficulty":"challenging","text":"Один корешок на полке без пыли. За ним — пустота и холод металла."},"type":"chest","look":"bookshelf","contents":[{"give_item":"salt_pouch"},{"give_gold":10}]},{"id":"archive_to_alley","zone":"door","type":"exit","kind":"door","to":"alley"},{"id":"efim_at_desk","zone":"desk","type":"npc","character":"efim","dialogue":{"type":"dialogue","id":"talk_efim","nodes":[{"id":"n1","speaker":"efim","text":"Кто здесь?! А, Стрельцова. Выросла. Всё равно без стука не входят.","emotion":"surprised","passive":[],"choices":[],"next":"n2"},{"id":"n2","speaker":"arina","text":"Ефим Лукич, мне нужна правда о магистре.","emotion":"neutral","passive":[],"choices":[{"text":"Показать журнал Олеандра","condition":{"has_item":"ledger"},"effects":[{"learn_skill":"salt_ward"}],"next":"n3"},{"text":"Что вы о нём знаете?","effects":[],"next":"n4"},{"text":"Смотритель заказывал ящиками соль. Учёному столько не нужно. Зачем?","effects":[],"next":"n3","check":{"skill":"knowledge","difficulty":"challenging","red":false,"failure":"n4"}}]},{"id":"n3","speaker":"efim","text":"Подношения морю… Слушай. Тьма из глубин боится соли. Очерти круг — и она не тронет.","emotion":"scared","passive":[],"choices":[],"next":"end"},{"id":"n4","speaker":"efim","text":"Знаю, что он платит за аренду маяка золотом, которого у учёных не бывает. Его бумаги — в сейфе наверху, если хватит духу.","emotion":"angry","passive":[],"choices":[],"next":"end"}],"start_node":"n1","entries":[]},"barks":[{"text":"Сорок лет… всё записано… всё…"},{"text":"Не трогай полки! Там порядок.","condition":{"flag":"found_ledger","is":false}}]},{"id":"safe","zone":"shelves","type":"chest","look":"chest","contents":[{"give_item":"ledger"},{"set_flag":"found_ledger","value":true},{"give_item":"harbor_badge"}]},{"id":"arrivals_book","zone":"window","type":"thing","look":"bookshelf","name":"Книга прибытий","event":{"type":"choice","id":"read_arrivals","prompt":"Последняя запись — рукой смотрителя: «Магистр опять заказал ящик соли. Зачем учёному столько соли?»","options":[{"text":"Переписать запись в блокнот.","effects":[{"give_item":"salt_order"}]}]},"once":true}],"on_enter":[]},{"id":"lighthouse_foot","title":"Подножие маяка","intro":"Тропа вдоль обрыва выводит к маяку. Дверь открыта, и на пороге, будто ждал гостей, стоит человек в фиолетовой мантии.","theme":"forest","background":{"setting":"outdoor","time":"night","sky":"moon","far":"sea_cliffs","props":[],"ground":"rock","overlay":"fog","mood_palette":"violet_dread"},"size":"medium","floors":1,"zones":[{"id":"path","floor":0,"name":"тропа"},{"id":"rocks","floor":0,"name":"скалы"},{"id":"door","floor":0,"name":"дверь маяка"}],"objects":[{"id":"cliffs_to_alley","zone":"path","type":"exit","kind":"left_edge","to":"alley"},{"id":"wormwood_patch","zone":"rocks","type":"gather","look":"bush","name":"Морская полынь","item":"sea_wormwood","amount":2,"skill":"knowledge"},{"id":"fishers_fire","zone":"path","type":"station","look":"campfire","name":"Костёр рыбаков","kind":"campfire"},{"id":"oleander_at_door","zone":"rocks","condition":{"not":{"defeated":"guardians"}},"type":"npc","character":"oleander","dialogue":{"type":"dialogue","id":"meet_oleander","nodes":[{"id":"n1","speaker":"oleander","text":"Следователь Стрельцова. Море шептало, что вы придёте.","emotion":"happy","passive":[],"choices":[],"next":"n2"},{"id":"n2","speaker":"arina","text":"Где смотритель и остальные?","emotion":"angry","passive":[{"skill":"logic","difficulty":"medium","text":"«Море шептало». Он говорит о море, как о заказчике. Кто-то платит ему — и это не город."}],"choices":[{"text":"Ты ответишь за каждого пропавшего.","effects":[],"next":"n3"},{"text":"Я читала твой журнал. Дат там хватит на виселицу.","condition":{"has_item":"ledger"},"effects":[],"next":"n4"},{"text":"Молча выдержать его взгляд.","effects":[],"next":"n6","check":{"skill":"will","difficulty":"challenging","red":true,"failure":"n5","damage":"morale"}}]},{"id":"n6","speaker":"oleander","text":"Вы не боитесь. Любопытно. Те, кого я отдал морю, тоже сначала не боялись. Потом — благодарили.","emotion":"surprised","passive":[],"choices":[],"next":"n5"},{"id":"n3","speaker":"oleander","text":"Они там, где им и место. Впрочем, спорить я не люблю.","emotion":"neutral","passive":[],"choices":[],"next":"n5"},{"id":"n4","speaker":"oleander","text":"Вы рылись в моих бумагах? Как грубо.","emotion":"surprised","passive":[],"choices":[],"next":"n5"},{"id":"n5","speaker":"oleander","text":"Пусть с вами поговорит туман.","emotion":"angry","passive":[],"choices":[],"next":"end"}],"start_node":"n1","entries":[]},"barks":[{"text":"Слышите? Море считает шаги."},{"text":"Соль? Учёному нужна соль, следователь. Только и всего.","condition":{"flag":"oleander_exposed","is":true}}]},{"id":"guardians","zone":"door","type":"enemy","enemies":["cultist","shade"],"on_win":[],"on_lose":"game_over","can_flee":false},{"id":"cliffs_to_tower","zone":"door","type":"exit","kind":"door","to":"tower","requires":{"defeated":"guardians"},"locked_text":"Служители тумана преграждают путь."}],"on_enter":[]},{"id":"tower","title":"Башня маяка","intro":"Олеандр исчез, оставив запах соли. Винтовая лестница уходит вверх, к фонарной, где когда-то горел огонь.","theme":"castle","background":{"setting":"indoor","time":"night","far":"room_wall","props":[],"ground":"metal","overlay":"none","mood_palette":"cold_sea"},"size":"small","floors":3,"zones":[{"id":"hall","floor":0,"name":"нижний зал"},{"id":"middle","floor":1,"name":"середина башни"},{"id":"lamp","floor":2,"name":"фонарная"}],"objects":[{"id":"tower_to_cliffs","zone":"hall","type":"exit","kind":"door","to":"lighthouse_foot"},{"id":"keeper_diary","zone":"middle","type":"thing","look":"bookshelf","name":"Дневник смотрителя","event":{"type":"narration","id":"read_diary","text":"«Если со мной что-то случится — линзу одному не удержать. Пусть огонь зажигают двое.»"},"once":true},{"id":"great_lens","zone":"lamp","type":"thing","look":"candelabra","name":"Великая линза","event":{"type":"dialogue","id":"relight","nodes":[{"id":"n1","speaker":"narrator","text":"Огромная линза треснула. Одной её не удержать, пока зажигаешь фитиль.","passive":[],"choices":[{"text":"Тим, держи линзу. Я зажгу.","condition":{"all":[{"flag":"tim_joined","is":true},{"flag":"trusted_tim","is":true}]},"effects":[{"goto":"ending_dawn"}],"next":"end"},{"text":"Зажечь огонь в одиночку.","effects":[{"goto":"ending_fog"}],"next":"end"},{"text":"Ещё не время.","effects":[],"next":"end"}]}],"start_node":"n1","entries":[]},"once":false}],"on_enter":[]}],"start_location":"pier","endings":[{"id":"ending_dawn","title":"Рассвет над бухтой","text":"Луч маяка разрезает туман. Внизу, на камнях, приходят в себя пропавшие люди. Тимофей смеётся, и Арина впервые за много лет смеётся вместе с ним.","kind":"good"},{"id":"ending_fog","title":"Туман остаётся","text":"Линза выскальзывает из рук и разбивается. Огонь горит, но свет тонет в тумане. Арина спасла город этой ночью — но не тех, кого забрало море.","kind":"bad"}],"levels":{"pier":{"width":36,"height":8,"tiles":["|...................................","|...................................","|...................................","|...................................","|...................................","|...................................","####################################","####################################"],"floors":[{"y":5,"x0":1,"x1":34}],"links":[],"objects":[{"id":"pier_to_alley","floor":0,"x":34},{"id":"salt_crust","floor":0,"x":7},{"id":"loose_plank","floor":0,"x":16},{"id":"tim_on_pier","floor":0,"x":19},{"id":"marfa_at_stall","floor":0,"x":27}],"spawns":[{"from":"default","floor":0,"x":3},{"from":"alley","floor":0,"x":33}]},"alley":{"width":36,"height":8,"tiles":["....................................","....................................","....................................","....................................","....................................","....................................","####################################","####################################"],"floors":[{"y":5,"x0":1,"x1":34}],"links":[],"objects":[{"id":"alley_to_pier","floor":0,"x":1},{"id":"alley_to_cliffs","floor":0,"x":34},{"id":"torn_letter","floor":0,"x":7},{"id":"rats","floor":0,"x":17},{"id":"net_crates","floor":0,"x":26},{"id":"alley_to_archive","floor":0,"x":29}],"spawns":[{"from":"default","floor":0,"x":3},{"from":"pier","floor":0,"x":2},{"from":"archive","floor":0,"x":29},{"from":"lighthouse_foot","floor":0,"x":33}]},"archive":{"width":24,"height":14,"tiles":["|......................|","|......................|","|......................|","|......................|","|......................|","|......................|","|===================H==|","|..................